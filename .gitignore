# --- Python ---
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# --- Generated by the tool (rebuild any time with build.bat / make_pdfs.bat) ---
projects/*/output/
projects/*/pdf/
projects/*/_work/

# --- Your own projects stay local: only the Example project is tracked.
# (Remove these two lines if you want to track your projects in a private repo.)
projects/*
!projects/Example/

# --- Local-only reference material (third-party sample worksheets, personal path/user metadata) ---
tool/reference/

# --- Editors and OS ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# --- Mathcad temporary/backup files ---
~$*
*.bak
